{
	"apiVersion": 3,
	"name": "vulopilot/table-of-contents",
	"title": "Table of Contents",
	"category": "vulopilot",
	"icon": "editor-ul",
	"description": "Automatically lists this post's headings and links to each one. Always reflects the post's current heading structure - nothing to keep in sync by hand.",
	"textdomain": "vulopilot",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Table of Contents"
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"minLevel": {
			"type": "number",
			"default": 2
		},
		"maxLevel": {
			"type": "number",
			"default": 6
		},
		"includedLevels": {
			"type": "array",
			"default": [],
			"items": { "type": "number" }
		},
		"excludedHeadings": {
			"type": "array",
			"default": [],
			"items": { "type": "string" }
		},
		"nestedList": {
			"type": "boolean",
			"default": true
		},
		"collapsible": {
			"type": "boolean",
			"default": false
		},
		"collapseInitialState": {
			"type": "string",
			"default": "expanded"
		},
		"smoothScroll": {
			"type": "boolean",
			"default": true
		},
		"scrollOffset": {
			"type": "number",
			"default": 0
		},
		"contentFontSize": {
			"type": "string",
			"default": ""
		},
		"contentColor": {
			"type": "string",
			"default": ""
		},
		"contentLineHeight": {
			"type": "number",
			"default": 1.6
		},
		"contentListStyle": {
			"type": "string",
			"default": "disc"
		},
		"contentGap": {
			"type": "string",
			"default": "0.25em"
		},
		"titleFontSize": {
			"type": "string",
			"default": ""
		},
		"titleColor": {
			"type": "string",
			"default": ""
		},
		"titleLineHeight": {
			"type": "number",
			"default": 1.4
		},
		"titlePadding": {
			"type": "object",
			"default": {}
		},
		"titleMargin": {
			"type": "object",
			"default": { "bottom": "0.5em" }
		},
		"sectionBackground": {
			"type": "string",
			"default": ""
		},
		"sectionPadding": {
			"type": "object",
			"default": { "top": "1em", "right": "1.25em", "bottom": "1em", "left": "1.25em" }
		},
		"sectionMargin": {
			"type": "object",
			"default": { "top": "1.5em", "bottom": "1.5em" }
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide" ]
	}
}
