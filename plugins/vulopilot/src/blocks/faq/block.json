{
	"apiVersion": 3,
	"name": "vulopilot/faq",
	"title": "FAQ",
	"category": "vulopilot",
	"icon": "editor-help",
	"description": "A list of questions and answers that also outputs real FAQPage schema.org structured data for search engines.",
	"textdomain": "vulopilot",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"attributes": {
		"questions": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"question": { "type": "string" },
					"answer": { "type": "string" }
				}
			}
		},
		"questionColor": { "type": "string" },
		"questionFontSize": { "type": "string" },
		"answerColor": { "type": "string" },
		"answerFontSize": { "type": "string" },
		"design": { "type": "string", "default": "classic" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"background": true,
			"text": true,
			"gradient": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"textAlign": true,
			"textDecoration": true,
			"textTransform": true,
			"letterSpacing": true
		}
	}
}
