{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"category": "widgets",
	"textdomain": "vulocart",
	"style": "vulocart-storefront",
	"editorScript": "vulocart-storefront-editor",
	"name": "vulocart/product-gallery",
	"title": "Product Gallery",
	"description": "The product photos: a large image with thumbnails.",
	"icon": "format-gallery",
	"ancestor": [
		"vulocart/product-details"
	],
	"usesContext": [
		"vulocart/product",
		"vulocart/query"
	],
	"supports": {
		"html": false,
		"spacing": {
			"margin": true
		},
		"__experimentalBorder": {
			"radius": true
		}
	}
}
